<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <timestamp key="startupTime" datePattern="yyyyMMdd-HHmmss"/>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%blue([%d{HH:mm:ss}]) %highlight([%thread/%level]) %cyan([%logger{36}]) %msg%n</pattern>
        </encoder>
    </appender>
    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <file>publisher/logs/publisher-${startupTime}.log</file>
        <encoder>
            <pattern>[%d{HH:mm:ss}] [%thread/%level] [%logger{36}] - %msg%n</pattern>
        </encoder>
        <charset>UTF-8</charset>
    </appender>
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>